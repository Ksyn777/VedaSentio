# Docker / PostgreSQL
POSTGRES_DB=vedasentio
POSTGRES_USER=vedasentio_app
POSTGRES_PASSWORD=CHANGE_ME

# Backend -> PostgreSQL
VEDASENTIO_DB_HOST=127.0.0.1
VEDASENTIO_DB_PORT=5433
VEDASENTIO_DB_NAME=vedasentio
VEDASENTIO_DB_USER=vedasentio_app
VEDASENTIO_DB_PASSWORD=CHANGE_ME

# Backend -> MQTT
VEDASENTIO_MQTT_USER=CHANGE_ME
VEDASENTIO_MQTT_PASSWORD=CHANGE_ME

# Application security keys
VEDASENTIO_DATA_ENCRYPTION_KEY_B64=CHANGE_ME
VEDASENTIO_LOOKUP_HMAC_KEY_B64=CHANGE_ME
VEDASENTIO_JWT_SIGNING_KEY_B64=CHANGE_ME

# Optional push notifications
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
